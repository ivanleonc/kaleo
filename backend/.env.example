DATABASE_URL=postgres://usuario:password@localhost:5432/tu_base_de_datos
JWT_SECRET=cambia_este_secreto_largo_y_aleatorio
CORS_ORIGIN=http://localhost:5173
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# --- Solo despliegue ---
# Documentación Swagger: apagada salvo 'true'. Si se enciende, exige Basic Auth.
# SWAGGER_ENABLED=false
# SWAGGER_USER=dev
# SWAGGER_PASSWORD=cambia_esta_clave

# --- Emails transaccionales ---
# Opción A (recomendada en hosting free: puerto 443, nunca filtrado).
# Brevo: SMTP & API -> API Keys -> Generate. El remitente debe estar verificado.
# BREVO_API_KEY=xkeysib-tu-clave
#
# Opción B (SMTP clásico, puede estar filtrado según el host):
# Brevo: host smtp-relay.brevo.com, puerto 587, user = tu email, pass = clave SMTP del dashboard.
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_USER=tu-email@ejemplo.com
# SMTP_PASS=tu-clave-smtp
# Remitente visible (en Brevo debe estar verificado como remitente):
# EMAIL_FROM=Tu SaaS <tu-email@ejemplo.com>
