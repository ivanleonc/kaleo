# URL del backend (OBLIGATORIA en producción: se hornea en el build).
# Desarrollo:
VITE_API_URL=http://localhost:3000/api
# Producción (ejemplo — pon la URL real de Render):
# VITE_API_URL=https://tu-api.onrender.com/api

# --- Observabilidad (opcional) ---
# Sentry: crear proyecto Vue en sentry.io → Settings → Client Keys (DSN).
# Sin esta variable Sentry queda desactivado; el build y los tests funcionan igual.
# VITE_SENTRY_DSN=https://xxxxxxxx@oxxxxxxxx.ingest.sentry.io/xxxxxxx
# Versión de la release (para agrupar eventos en Sentry). Cloudflare Pages puede
# inyectarla con CF_PAGES_COMMIT_SHA en el build command si se desea.
# VITE_APP_VERSION=1.0.0
