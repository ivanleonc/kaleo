{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:run": "vitest run",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint src",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "@sentry/vue": "^11.2.0",
    "@tabler/icons-vue": "^3.44.0",
    "@tanstack/vue-table": "^9.2.4",
    "axios": "^1.16.1",
    "echarts": "^6.1.0",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "reka-ui": "^2.11.0",
    "vue": "^3.5.32",
    "vue-echarts": "^8.3.0",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.2",
    "globals": "^17.13.0",
    "jsdom": "^29.0.2",
    "npm-run-all2": "^8.0.4",
    "prettier": "3.8.3",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.0.8",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vitest": "^4.1.4",
    "vue-tsc": "^3.2.6"
