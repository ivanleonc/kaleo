/*
  # Evita que Cloudflare modifique los archivos HTML de VitePress.
  # Auto Minify de Cloudflare puede romper los scripts inline de SSR.
  X-Content-Type-Options: nosniff
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000

/*.js
  Cache-Control: public, max-age=31536000

/*.css
  Cache-Control: public, max-age=31536000
